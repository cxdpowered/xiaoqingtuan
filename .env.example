ENVIRONMENT=dev
DRIVER=~fastapi+~httpx+~websockets
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]
COMMAND_SEP=["."]
NICKNAME=["小青团"]

# DeepSeek（对话 / 工具选择 / 记忆抽取）。最快的现行模型是 deepseek-v4-flash。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_MAX_HISTORY_MESSAGES=12

# web_search 工具（可选）：留空则返回 mock 结果，填入后走 Tavily（免费 1000/月）。
# TAVILY_API_KEY=

# 长期记忆 / 派生索引路径（可选，默认在项目内 data/ 与 wiki/，容器里可挂 volume）。
# XQT_DATA_DIR=
# XQT_WIKI_DIR=
# XQT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# XQT_EMBEDDING_DIM=512

# 接入外部 MCP 服务（可选）：指向 MCP server 配置 JSON。需先 `uv sync --extra mcp`。
# 配置格式与字段见 README「接入任意 MCP 服务」。留空则不接入，不影响内置工具。
# XQT_MCP_CONFIG=./mcp.config.json
# 图书馆后端：mock(默认) | mcp(独立 MCP 服务) | playwright(阶段三)。
# XQT_LIBRARY_PROVIDER=mock

# LLBot / OneBot V11 reverse WebSocket:
# Configure LLBot OneBot11 reverse WS url as:
# ws://127.0.0.1:8080/onebot/v11/ws
# Optional: if you set a token in LLBot, set the same value here.
# ONEBOT_ACCESS_TOKEN=your-token

# Example:
# WXCLAW_ACCOUNTS='[{"account_id":"账号 ID","token":"登录后拿到的 token","base_url":"https://ilinkai.weixin.qq.com","enabled":true}]'
WXCLAW_ACCOUNTS=[]
